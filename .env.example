# ==========================================================================
# BRMP DIY POULTRY TRACKER - CLOUD DATABASE CONFIGURATION
# ==========================================================================

# --------------------------------------------------------------------------
# PILIHAN 1: GOOGLE SPREADSHEET (Sangat Direkomendasikan untuk Vercel)
# Didapat dari menu "Deploy" -> "Web App" di Google Apps Script pada Spreadsheet
# Lihat petunjuk lengkap di file: google-apps-script.js
# --------------------------------------------------------------------------
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx.../exec

# --------------------------------------------------------------------------
# PILIHAN 2: SUPABASE CLOUD (Opsional jika ingin menggunakan PostgreSQL)
# Dapatkan dari: https://supabase.com/dashboard/project/_/settings/api
# --------------------------------------------------------------------------
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Port Server Lokal (Opsional, bawaan 3000)
PORT=3000
